{
  "name": "digital-wallet-payment-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade digital wallet and payment platform backend",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "admin:grant": "npm run build --silent && node dist/scripts/set-admin-role.js ADMIN",
    "admin:revoke": "npm run build --silent && node dist/scripts/set-admin-role.js USER",
    "test": "npm run build && NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:unit": "npm run build && NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/unit",
    "test:integration": "npm run build && NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/integration",
    "smoke": "node scripts/smoke-test.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^5.12.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^11.11.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.5.0",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4",
    "supertest": "^7.1.4",
    "testcontainers": "^11.11.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
