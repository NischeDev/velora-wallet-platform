# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000
SERVE_FRONTEND=false
FRONTEND_DIST_PATH=frontend/dist

# PostgreSQL application connection
DATABASE_URL=postgresql://wallet_app:change_me_postgres_password:5432/wallet_platform
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_SSL=false

# Redis application connection
REDIS_URL=redis://:change_me_redis_password:6379

# Authentication (replace with long random values outside development)
JWT_ACCESS_SECRET=replace_with_32_plus_random_characters_access
JWT_REFRESH_SECRET=replace_with_32_plus_random_characters_refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=12

# Wallet defaults and browser access
DEFAULT_CURRENCY=INR
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
IDEMPOTENCY_TTL_SECONDS=86400

# India payment sandbox. Keep simulated until Test Mode keys are configured.
PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_MS=10000

# Docker Compose host-port overrides
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
UI_PORT=8080

# Docker Compose container credentials (development only)
POSTGRES_USER=wallet_app
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=wallet_platform
REDIS_PASSWORD=change_me_redis_password
